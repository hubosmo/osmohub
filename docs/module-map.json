  "database": {
    "tables": {
      "users":              { "module": "auth.actions", "relations": ["progresso_topicos", "tentativas_quiz", "planos_estudos"] },
      "disciplinas":        { "module": "admin.disciplinas", "relations": ["areas", "simulacoes"] },
      "areas":              { "module": "admin.disciplinas", "relations": ["disciplinas", "topicos"] },
      "topicos":            { "module": "admin.disciplinas", "relations": ["areas", "videos", "artigos", "quizzes", "topico_simulacoes", "progresso_topicos", "itens_plano"] },
      "videos":             { "module": "admin.videos", "relations": ["topicos"] },
      "artigos":            { "module": "admin.artigos", "relations": ["topicos"] },
      "simulacoes":         { "module": "admin.simulacoes", "relations": ["disciplinas", "topico_simulacoes"] },
      "topico_simulacoes":  { "module": "admin.simulacoes", "relations": ["topicos", "simulacoes"] },
      "quizzes":            { "module": "admin.quizzes", "relations": ["topicos", "questoes", "tentativas_quiz"] },
      "questoes":           { "module": "admin.quizzes", "relations": ["quizzes", "opcoes"] },
      "opcoes":             { "module": "admin.quizzes", "relations": ["questoes"] },
      "progresso_topicos":  { "module": "lib.db.progresso", "relations": ["users", "topicos"] },
      "tentativas_quiz":    { "module": "lib.db.progresso", "relations": ["users", "quizzes"] },
      "planos_estudos":     { "module": "lib.db.plano", "relations": ["users", "itens_plano"] },
      "itens_plano":        { "module": "lib.db.plano", "relations": ["planos_estudos", "topicos"] }
    }
  },

  "api_routes": {
    "/api/mux/upload":   { "module": "admin.videos", "method": "POST", "description": "Cria Mux upload URL" },
    "/api/mux/webhook":  { "module": "admin.videos", "method": "POST", "description": "Recebe eventos do Mux (video ready)" },
    "/auth/callback":    { "module": "auth.pages", "method": "GET", "description": "Callback OAuth Supabase" }
  }
}
