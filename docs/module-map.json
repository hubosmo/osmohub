  "database": {
    "tables": {
      "users": {
        "module": "auth.actions",
        "relations": [
          "progresso_topicos",
          "tentativas_quiz",
          "pastas"
        ]
      },
      "disciplinas": {
        "module": "admin.disciplinas",
        "relations": [
          "areas",
          "simulacoes"
        ]
      },
      "areas": {
        "module": "admin.disciplinas",
        "relations": [
          "disciplinas",
          "topicos"
        ]
      },
      "topicos": {
        "module": "admin.disciplinas",
        "relations": [
          "areas",
          "videos",
          "artigos",
          "topico_quizzes",
          "topico_simulacoes",
          "progresso_topicos",
          "itens_pasta"
        ]
      },
      "videos": {
        "module": "admin.videos",
        "relations": [
          "topicos"
        ]
      },
      "artigos": {
        "module": "admin.artigos",
        "relations": [
          "topicos"
        ]
      },
      "simulacoes": {
        "module": "admin.simulacoes",
        "relations": [
          "disciplinas",
          "topico_simulacoes"
        ]
      },
      "topico_simulacoes": {
        "module": "admin.simulacoes",
        "relations": [
          "topicos",
          "simulacoes"
        ]
      },
      "quizzes": {
        "module": "admin.quizzes",
        "relations": [
          "topico_quizzes",
          "questoes",
          "tentativas_quiz"
        ],
        "note": "standalone — N:N com topicos via topico_quizzes"
      },
      "topico_quizzes": {
        "module": "admin.quizzes",
        "relations": [
          "topicos",
          "quizzes"
        ],
        "note": "junction N:N; campos: topico_id, quiz_id, ordem"
      },
      "questoes": {
        "module": "admin.quizzes",
        "relations": [
          "quizzes",
          "opcoes"
        ],
        "note": "enunciado: String; tipos: MULTIPLA_ESCOLHA | VERDADEIRO_FALSO | ESCOLHA_IMAGEM; imagem_url opcional"
      },
      "opcoes": {
        "module": "admin.quizzes",
        "relations": [
          "questoes"
        ],
        "note": "imagem_url para tipo ESCOLHA_IMAGEM — referência a URL já existente, sem re-upload"
      },
      "progresso_topicos": {
        "module": "lib.db.progresso",
        "relations": [
          "users",
          "topicos"
        ]
      },
      "tentativas_quiz": {
        "module": "lib.db.progresso",
        "relations": [
          "users",
          "quizzes"
        ]
      },
      "pastas": {
        "module": "lib.db.plano",
        "relations": [
          "users",
          "itens_pasta"
        ]
      },
      "itens_pasta": {
        "module": "lib.db.plano",
        "relations": [
          "pastas",
          "topicos"
        ]
      }
    }
  },
  "api_routes": {
    "/api/mux/upload": {
      "module": "admin.videos",
      "method": "POST",
      "description": "Cria Mux upload URL"
    },
    "/api/mux/webhook": {
      "module": "admin.videos",
      "method": "POST",
      "description": "Recebe eventos do Mux (video ready)"
    },
    "/auth/callback": {
      "module": "auth.pages",
      "method": "GET",
      "description": "Callback OAuth Supabase"
    }
  }
}
