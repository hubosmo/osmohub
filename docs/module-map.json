{
  "_meta": {
    "version": "1.0.0",
    "updated": "2026-09-12",
    "description": "Mapa de módulos do projeto Osmo. Atualizar sempre que um módulo for criado, alterado ou removido. Use para verificar impacto antes de qualquer implementação.",
    "status_legend": {
      "planned": "não iniciado",
      "in_progress": "em desenvolvimento",
      "done": "concluído",
      "blocked": "bloqueado por dependência"
    }
  },

  "modules": {

    "foundation.env": {
      "status": "done",
      "description": "Validação e tipagem de variáveis de ambiente",
      "files": ["src/lib/env.ts"],
      "depends_on": ["zod"],
      "used_by": ["foundation.supabase", "foundation.prisma", "lib.video"],
      "tables": [],
      "env_vars": [
        "NEXT_PUBLIC_SUPABASE_URL", "NEXT_PUBLIC_SUPABASE_ANON_KEY",
        "SUPABASE_SERVICE_ROLE_KEY", "DATABASE_URL", "DIRECT_URL",
        "MUX_TOKEN_ID", "MUX_TOKEN_SECRET", "MUX_WEBHOOK_SECRET"
      ]
    },

    "foundation.supabase": {
      "status": "done",
      "description": "Clientes Supabase para browser e servidor (SSR)",
      "files": [
        "src/lib/supabase/client.ts",
        "src/lib/supabase/server.ts"
      ],
      "depends_on": ["@supabase/supabase-js", "@supabase/ssr", "foundation.env"],
      "used_by": ["auth.*", "middleware", "lib.db.*"],
      "tables": [],
      "notes": "client.ts = uso em Client Components; server.ts = uso em Server Components e Server Actions"
    },

    "foundation.prisma": {
      "status": "done",
      "description": "Singleton do Prisma Client para acesso ao banco",
      "files": ["src/lib/db/prisma.ts", "prisma/schema.prisma"],
      "depends_on": ["@prisma/client", "foundation.env"],
      "used_by": ["lib.db.*"],
      "tables": ["ALL"],
      "notes": "Nunca usar prisma diretamente em componentes — sempre via lib/db/"
    },

